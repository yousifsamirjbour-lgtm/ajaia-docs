terraform {
  required_version = ">= 1.5.0"
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
  }
}

provider "aws" {
  region = var.aws_region
}

# Data source for existing VPC
data "aws_vpc" "default" {
  default = true
}

# Security group allowing HTTP (80), HTTPS (443), and SSH (22)
resource "aws_security_group" "ajaia_sg" {
  name        = "${var.app_name}-sg"
  description = "Security group for Ajaia Docs application"
  vpc_id      = data.aws_vpc.default.id

  ingress {
    description = "SSH access"
    from_port   = 22
    to_port     = 22
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }

  ingress {
    description = "HTTP access"
    from_port   = 80
    to_port     = 80
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }

  ingress {
    description = "HTTPS access"
    from_port   = 443
    to_port     = 443
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }

  egress {
    description = "Allow all outbound traffic"
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }

  tags = {
    Name        = "${var.app_name}-sg"
    Environment = var.environment
  }
}

# Note on Free Tier Architecture:
# AWS Free Tier limits EC2 750 hours/month and EBS 30GB per account.
# To guarantee zero unexpected charges on an account with existing workloads,
# Ajaia Docs is containerized with Docker and co-hosted behind Nginx reverse proxy
# on the verified t3.micro EC2 instance.
